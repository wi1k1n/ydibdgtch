<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="String">
    <DisplayString>{str}</DisplayString>
  </Type>

  <Type Name="ChessPiece">
    <DisplayString>{m_piece,nvo} {m_color,nvo}</DisplayString>
  </Type>

  <Type Name="ChessPieceLocation">
	  <DisplayString Condition="(m_row == 0)">a{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 1)">b{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 2)">c{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 3)">d{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 4)">e{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 5)">f{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 6)">g{m_col+1,d}</DisplayString>
    <DisplayString Condition="(m_row == 7)">h{m_col+1,d}</DisplayString>
  </Type>

  <Type Name="SenseBoardState">
    <DisplayString>{ m_rows[0], nvoXb }-{ m_rows[1], nvoXb }-{ m_rows[2], nvoXb }-{ m_rows[3], nvoXb }-{ m_rows[5], nvoXb }-{ m_rows[6], nvoXb }-{ m_rows[7], nvoXb }</DisplayString>
  </Type>

</AutoVisualizer>